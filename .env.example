# ShieldLab G4 – environment template. Copy to `.env` and fill in.
# NEVER commit the real .env file.

# --- API security ---
# Comma-separated SHA-256 hex digests of accepted API keys (preferred).
SHIELDLAB_API_KEY_HASHES=
# Or, dev-only: comma-separated plaintext keys (hashed at startup).
SHIELDLAB_API_KEYS=

# Strict CORS allowlist (comma-separated). '*' is forbidden unless SHIELDLAB_DEV=1.
SHIELDLAB_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Per-key rate limit (requests / minute).
SHIELDLAB_RATE_LIMIT_PER_MIN=60

# Per-IP flood/brute-force throttle applied to EVERY request (incl. failed auth
# and public endpoints). Defense-in-depth alongside the Caddy proxy.
SHIELDLAB_GLOBAL_RATE_LIMIT_PER_MIN=120

# Trust the X-Forwarded-For header for client-IP rate limiting. Set to 1 ONLY
# when running behind the bundled Caddy proxy (profile: proxy); 0 otherwise.
SHIELDLAB_TRUST_PROXY=0

# Set to 1 to enable dev-mode fallbacks (wildcard CORS, no-key acceptance).
SHIELDLAB_DEV=0

# --- UI authentication ---
SHIELDLAB_LICENSE_KEY=
SHIELDLAB_PRO_KEY_HASH=
SHIELDLAB_JWT_SECRET=

# --- Backend selection (job queue + blob storage) ---
# 'local' = filesystem + SQLite, no cloud (free/demo, e.g. an Oracle VM).
# 'azure' = Azure Queue + Blob (production). Unset = auto-detected from env.
SHIELDLAB_BACKEND=local
# Local backend data directory (the docker-compose stack maps this to /data).
SHIELDLAB_LOCAL_DATA_DIR=./.shieldlab_data

# --- docker-compose published ports ---
UI_PORT=8501
API_PORT=8000

# Public hostname for the auto-HTTPS Caddy proxy (profile: proxy).
# Use a real DNS name for a publicly-trusted cert; 'localhost' uses a local
# internal CA so you can smoke-test HTTPS without a domain.
SHIELDLAB_DOMAIN=localhost

# --- Azure storage (worker queue + blob) — only when SHIELDLAB_BACKEND=azure ---
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_QUEUE_NAME=simulation-jobs
