/control/verbose 1
/run/verbose 0
/event/verbose 0
/tracking/verbose 0
/process/em/verbose 0

/shield/geometry/clearLayers
/shield/geometry/transverseSize 10 cm
/shield/geometry/addLayer G4_Pb 1 cm 1

/shield/output/setDirectory results/gamma_lead_slab

/run/initialize
/gun/particle gamma
/gun/energy 662 keV
/run/beamOn 10000