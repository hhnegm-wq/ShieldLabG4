; EditorConfig — consistent coding style across editors and IDEs
; https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Python
[*.py]
indent_size = 4
max_line_length = 100

# C++ (Geant4 core — built in WSL)
[*.{cc,hh,cpp,hpp,h,cxx}]
indent_size = 2

# Web / config / data
[*.{yml,yaml,json,toml,jsonc}]
indent_size = 2

# Geant4 macros
[*.mac]
indent_size = 2

# Markdown — keep trailing whitespace (hard line breaks) and long lines
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# Makefiles require tabs
[{Makefile,makefile,*.mk}]
indent_style = tab

# Windows batch/PowerShell keep CRLF
[*.{ps1,psm1,cmd,bat}]
end_of_line = crlf
